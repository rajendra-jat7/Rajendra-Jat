<div class="ecom-product-grid">
  {% if section.settings.heading != blank %}
    <h2 class="ecom-grid-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.settings.collection != blank %}
    {% assign collection = collections[section.settings.collection] %}
    
    <div class="ecom-grid">
      {% for product in collection.products limit: section.settings.limit %}
        <div class="ecom-grid-item">
          <a href="{{ product.url }}" class="ecom-product-card">
            <div class="ecom-product-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '400x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div class="ecom-product-info">
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p>No collection selected</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Ecom Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Products per row"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Ecom Product Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
