{% schema %}
{
  "name": "Ecom Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Products per row"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8,
      "label": "Number of products to show"
    }
  ],
  "presets": [
    {
      "name": "Ecom Product Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
