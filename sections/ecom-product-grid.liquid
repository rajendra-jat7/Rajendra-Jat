{% comment %}
------------------------------------------------------------
Ecom Product Grid (Custom)
- Shows exactly 6 product tiles (images only, no name/price on the grid)
- Clicking a tile opens a vanilla JS modal with:
  • Title, Price, Description
  • Dynamic variant selectors (built from product.options/variants)
  • Add to Cart that calls /cart/add.js
- Rule: If selected options include BOTH "Black" and "Medium",
        auto-add the configured "Soft Winter Jacket" product.
------------------------------------------------------------
{% endcomment %}

<section class="ecom-grid" id="ecom-grid-{{ section.id }}">
  {% assign products_array = '' %}
  <div class="ecom-grid__inner">
    {% for i in (1..6) %}
      {% assign p = section.settings["product_" | append: i ] %}
      <div class="ecom-grid__card" data-card-index="{{ forloop.index0 }}">
        {% if p %}
          {% if p.featured_image %}
            <img
              src="{{ p.featured_image | image_url: width: 1200 }}"
              alt="{{ p.title | escape }}"
              class="ecom-grid__img"
              loading="lazy"
            >
          {% else %}
            <div class="ecom-grid__img ecom-grid__img--placeholder"></div>
          {% endif %}
          <button class="ecom-grid__quick">Quick view</button>

          {%- comment -%}
          Embed a compact JSON the JS will read when opening the modal.
          Keep only what we need to keep payload small.
          {%- endcomment -%}
          <script type="application/json" id="product-json-{{ section.id }}-{{ forloop.index0 }}">
          {
            "id": {{ p.id | json }},
            "title": {{ p.title | json }},
            "handle": {{ p.handle | json }},
            "description": {{ p.description | strip_html | truncate: 300 | json }},
            "featured_image": {{ p.featured_image | image_url: width: 1600 | json }},
            "images": [
              {% for img in p.images %}
                {{ img | image_url: width: 1600 | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "options": [
              {% for opt in p.options_with_values %}
                {
                  "name": {{ opt.name | json }},
                  "values": [
                    {% for v in opt.values %}
                      {{ v | json }}{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "variants": [
              {% for v in p.variants %}
                {
                  "id": {{ v.id }},
                  "title": {{ v.title | json }},
                  "available": {{ v.available | json }},
                  "options": [
                    {% for o in v.options %}
                      {{ o | json }}{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ],
                  "price": {{ v.price | json }},
                  "price_formatted": {{ v.price | money | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "price_from": {{ p.price_min | money | json }}
          }
          </script>
        {% else %}
          <div class="ecom-grid__img ecom-grid__img--placeholder"></div>
          <button class="ecom-grid__quick" disabled>Pick a product</button>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  {%- comment -%}
  Re-usable Modal (one per section, populated by JS)
  {%- endcomment -%}
  <div class="ecom-modal" data-grid-modal hidden aria-hidden="true">
    <div class="ecom-modal__backdrop" data-modal-close></div>
    <div class="ecom-modal__dialog" role="dialog" aria-modal="true" aria-label="Product quick view">
      <button class="ecom-modal__close" type="button" data-modal-close aria-label="Close">×</button>
      <div class="ecom-modal__media">
        <img data-modal-image alt="">
      </div>
      <div class="ecom-modal__content">
        <h3 class="ecom-modal__title" data-modal-title></h3>
        <div class="ecom-modal__price" data-modal-price></div>
        <p class="ecom-modal__desc" data-modal-desc></p>

        <form class="ecom-modal__form" data-modal-form>
          <div class="ecom-modal__options" data-options-wrap></div>
          <input type="hidden" name="id" data-variant-id>
          <button class="ecom-btn ecom-btn--primary" type="submit" data-add-to-cart>Add to cart</button>
          <div class="ecom-modal__status" data-status></div>
        </form>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ecom Product Grid",
  "settings": [
    { "type": "header", "content": "Select 6 products (shown as 3x2 grid)" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" },
    { "type": "product", "id": "product_5", "label": "Product 5" },
    { "type": "product", "id": "product_6", "label": "Product 6" },

    { "type": "header", "content": "Auto-add bundle rule" },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Soft Winter Jacket (auto-added when selection is Black + Medium)"
    },
    {
      "type": "text",
      "id": "trigger_color",
      "label": "Trigger Color value",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "trigger_size",
      "label": "Trigger Size value",
      "default": "Medium"
    }
  ],
  "presets": [
    { "name": "Ecom Product Grid", "category": "Custom Sections" }
  ]
}
{% endschema %}
