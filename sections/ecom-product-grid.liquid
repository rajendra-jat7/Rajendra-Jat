<section class="ecom-product-grid">
<p class="text-tisso">Tisso vison in the wild</p>
  <div class="product-grid">
    {% for product in collections.all.products limit: section.settings.products_to_show %}
      <div class="product-card">
        <div class="product-image">
          <img src="{{ product.featured_image | image_url: width: 433, height: 444, crop: 'center' }}" alt="{{ product.title }}">
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Ecom Product Grid",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Featured Products" },
    { "type": "range", "id": "products_to_show", "label": "Number of Products", "default": 8, "min": 2, "max": 20, "step": 1 }
  ],
  "presets": [{ "name": "Ecom Product Grid" }]
}
{% endschema %}
