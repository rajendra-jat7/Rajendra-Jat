{% schema %}
{
  "name": "Homepage Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_banner_image",
      "label": "Top Banner Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Bottom Right Image"
    }
  ]
}
{% endschema %}

<div class="homepage-banner">
  <!-- Top Header Bar -->
  <div class="top-header-bar">
    <div class="header-left">TISSO VISION</div>
    <div class="header-center">Find the ideal gift for your loved ones.</div>
    <div class="header-right">
      <a href="#" class="btn-yellow">CHOOSE GIFT →</a>
    </div>
  </div>

  <!-- Banner Content -->
  <div class="banner-content">
    <div class="top-banner-container">
      {% if section.settings.top_banner_image != blank %}
        <img src="{{ section.settings.top_banner_image | image_url: width: 1600 }}" alt="Top Banner" class="top-banner-img">
      {% endif %}

      <div class="banner-text">
        <h1>The Gift Guide</h1>
        <p>
          Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.
        </p>
        <a href="#" class="btn-black">SHOP NOW →</a>
      </div>
    </div>

    {% if section.settings.bottom_right_image != blank %}
      <img src="{{ section.settings.bottom_right_image | image_url: width: 600 }}" alt="Bottom Right Image" class="bottom-right-img">
    {% endif %}
  </div>

  <!-- Footer Strip -->
  <div class="footer-strip">
    SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
  </div>
</div>

<style>
/* ---------- HEADER BAR ---------- */
.top-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 10px 20px;
  font-size: 0.95rem;
  border-bottom: 1px solid #eee;
}
.header-left {
  font-weight: bold;
}
.header-center {
  text-align: center;
  flex: 1;
}
.header-right .btn-yellow {
  background: #FFD700;
  color: black;
  padding: 8px 14px;
  border-radius: 4px;
  font-weight: 600;
  text-decoration: none;
}

/* ---------- BANNER CONTENT ---------- */
.banner-content {
  position: relative;
  width: 100%;
  text-align: left;
  padding: 20px;
}

.top-banner-container {
  position: relative;
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

.top-banner-img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}

.banner-text {
  position: absolute;
  bottom: 20px;
  left: 20px;
  max-width: 500px;
}
.banner-text h1 {
  font-size: 3rem;
  font-weight: bold;
  margin: 0 0 12px;
}
.banner-text p {
  font-size: 1rem;
  margin: 0 0 16px;
  line-height: 1.5;
}
.btn-black {
  background: black;
  color: white;
  padding: 10px 18px;
  border-radius: 4px;
  text-decoration: none;
  font-weight: 600;
}

.bottom-right-img {
  position: absolute;
  bottom: 0;
  right: 0;
  max-width: 280px;
  height: auto;
  object-fit: contain;
}

/* ---------- FOOTER STRIP ---------- */
.footer-strip {
  background: #fff;
  color: red;
  text-align: center;
  font-weight: bold;
  padding: 12px 10px;
  border-top: 1px solid #eee;
}

/* ---------- RESPONSIVE (MOBILE) ---------- */
@media screen and (max-width: 768px) {
  /* Header changes */
  .top-header-bar {
    justify-content: space-between;
  }
  .header-left {
    font-size: 1.4rem;
    cursor: pointer;
  }
  .header-left::before {
    content: "☰ ";
    font-size: 1.2rem;
  }
  .header-center {
    font-weight: bold;
  }
  .header-right {
    display: none;
  }

  /* Banner changes */
  .top-banner-container {
    display: none; /* hide top image on mobile */
  }
  .bottom-right-img {
    position: static;
    display: block;
    margin: 20px auto 0;
    max-width: 100%;
  }
  .banner-text {
    position: static;
    text-align: center;
    padding: 10px;
  }
  .banner-text h1 {
    font-size: 2rem;
  }
  .banner-text p {
    margin: 12px auto;
    max-width: 90%;
  }
  .btn-black {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
  }
}
</style>
