{% schema %}
{
  "name": "Homepage Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_banner_image",
      "label": "Top Banner Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Bottom Right Image"
    }
  ]
}
{% endschema %}

<div class="homepage-banner">
  <!-- Top Header Bar -->
  <div class="top-header-bar">
    <div class="header-left">
    {% if section.settings.header-left != blank %}
      <img src="{{ section.settings.header-left | image_url: width: 152 }}" 
           alt="Header Left" 
           class="header-left-img">
    {% endif %}
    </div>
    <div class="header-center">Find the ideal gift for your loved ones.</div>
    <div class="header-right">
      <a href="#" class="btn-yellow">CHOOSE GIFT →</a>
    </div>
  </div>

  <!-- Banner Content -->
<div class="banner-content">

  <!-- Top Banner Section -->
  <div class="top-banner-container">
    {% if section.settings.top_banner_image != blank %}
      <img src="{{ section.settings.top_banner_image | image_url: width: 1600 }}" 
           alt="Top Banner" 
           class="top-banner-img">
    {% endif %}
  </div>

  <!-- Bottom Banner Section -->
  <div class="bottom-banner-container">
    <div class="bottom-text">
      <h1>The Gift Guide</h1>
      <p>
        Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.
      </p>
      <a href="#" class="btn-black">SHOP NOW →</a>
    </div>

    {% if section.settings.bottom_right_image != blank %}
      <img src="{{ section.settings.bottom_right_image | image_url: width: 890 }}" 
           alt="Bottom Right Image" 
           class="bottom-right-img">
    {% endif %}
  </div>

  <!-- Footer Strip -->
  <div class="footer-strip">
    SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
  </div>
</div>

<style>
/* ---------- HEADER BAR ---------- */
.top-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F5F5;
  padding: 10px 50px;
  height: 64px;
  font-size: 16px;
}
.header-left {
  font-weight: bold;
}
.header-center {
  text-align: center;
  flex: 1;
}
.header-right .btn-yellow {
  background: #FFD700;
  color: black;
  padding: 8px 14px;
  border-radius: 4px;
  font-weight: 600;
  text-decoration: none;
}

/* ---------- BANNER CONTENT ---------- */
.banner-content {
  width: 100%;
}

.top-banner-container {
  height : 390px;
  text-align: center;
  overflow : hidden;
  width: 100%;
  max-width: 1440px;
}

.top-banner-img {
  max-width: 100%;
  max-height: 100%
  object-fit: cover;
  display: block;
}

/* Bottom Banner */
.bottom-banner-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 403px;
}

.bottom-text {
  flex: 1;
}

.bottom-text h1 {
  font-size: 70px;
  font-weight: 500;
  font-weight: bold;
  margin-bottom: 10px;
}
.bottom-text p {
  margin-bottom: 20px;
  line-height: 1.4;
}
.btn-black {
  display: inline-block;
  padding: 10px 20px;
  background: black;
  color: white;
  text-decoration: none;
  border-radius: 4px;
}

.bottom-right-img {
  width: 890px;
  height: 100%;
  object-fit: contain;
}

/* ---------- FOOTER STRIP ---------- */
.footer-strip {
  height: 34px;
  background: #f9f9f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- RESPONSIVE (MOBILE) ---------- */
@media screen and (max-width: 768px) {
  /* Header changes */
  .top-header-bar {
    justify-content: space-between;
  }
  .header-left {
    font-size: 1.4rem;
    cursor: pointer;
  }
  .header-left::before {
    content: "☰ ";
    font-size: 1.2rem;
  }
  .header-center {
    font-weight: bold;
  }
  .header-right {
    display: none;
  }

  /* Banner changes */
  .top-banner-container {
    display: none; /* hide top image on mobile */
  }
  .bottom-right-img {
    position: static;
    display: block;
    margin: 20px auto 0;
    max-width: 100%;
  }
  .banner-text {
    position: static;
    text-align: center;
    padding: 10px;
  }
  .banner-text h1 {
    font-size: 2rem;
  }
  .banner-text p {
    margin: 12px auto;
    max-width: 90%;
  }
  .btn-black {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
  }
}
</style>
