<section class="ecom-banner">
  <!-- Desktop hero -->
  {% if section.settings.image_desktop != blank %}
    <img class="banner-bg banner-bg--desktop"
         src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
         alt="{{ section.settings.image_alt }}">
  {% endif %}

  <!-- Mobile hero (shown on small screens) -->
  {% if section.settings.image_mobile != blank %}
    <img class="banner-bg banner-bg--mobile"
         src="{{ section.settings.image_mobile | image_url: width: 900 }}"
         alt="{{ section.settings.image_alt }}">
  {% endif %}

  <div class="banner-content page-width">
    {% if section.settings.kicker != blank %}
      <p class="ecom-kicker">{{ section.settings.kicker }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="ecom-heading">{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="ecom-subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    <div class="ecom-cta-wrap">
      {% if section.settings.cta1_label != blank %}
        <a class="ecom-btn ecom-btn--shine" href="{{ section.settings.cta1_link }}">{{ section.settings.cta1_label }}</a>
      {% endif %}
      {% if section.settings.cta2_label != blank %}
        <a class="ecom-btn ecom-btn--outline ecom-btn--shine" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
      {% endif %}
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Ecom Banner (desktop + mobile image)",
  "settings": [
    { "type":"image_picker","id":"image_desktop","label":"Desktop image" },
    { "type":"image_picker","id":"image_mobile","label":"Mobile image" },
    { "type":"text","id":"image_alt","label":"Image alt","default":"Banner"},

    { "type":"text","id":"kicker","label":"Top label (red box 1)","default":"NEW COLLECTION" },
    { "type":"text","id":"heading","label":"Main heading (red box 2)","default":"Style for Every Season" },
    { "type":"textarea","id":"subheading","label":"Subtitle (red box 3)","default":"Premium fits, everyday comfort." },

    { "type":"text","id":"cta1_label","label":"Primary button text","default":"Shop now" },
    { "type":"url","id":"cta1_link","label":"Primary button link" },
    { "type":"text","id":"cta2_label","label":"Secondary button text","default":"Explore" },
    { "type":"url","id":"cta2_link","label":"Secondary button link" }
  ],
  "presets":[{"name":"Ecom Banner"}]
}
{% endschema %}
