{% comment %}
  Homepage Banner Section
{% endcomment %}
<section class="homepage-banner">
  <!-- NAV BAR -->
  <div class="top-header-bar">
    <div class="nav-left">
      <span class="hamburger">☰</span>
      <span class="brand">TISSO VISION</span>
    </div>
    <div class="nav-center">
      <span class="tagline">Find the ideal gift for your loved ones.</span>
    </div>
    <div class="nav-right">
      <a href="/collections/all" class="btn btn-yellow">CHOOSE GIFT →</a>
    </div>
  </div>

  <!-- TOP IMAGE + TEXT (Desktop Only) -->
  <div class="top-banner-container">
    {% if section.settings.top_image %}
      <img src="{{ section.settings.top_image | image_url }}" alt="Top Banner" class="top-banner-img" />
    {% endif %}

    <div class="banner-text">
      <h2>The Gift Guide</h2>
      <p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
      <a href="/collections/all" class="btn btn-black">SHOP NOW →</a>
    </div>
  </div>

  <!-- BOTTOM IMAGE -->
  <div class="bottom-banner-container">
    {% if section.settings.bottom_image %}
      <img src="{{ section.settings.bottom_image | image_url }}" alt="Bottom Banner" class="bottom-banner-img" />
    {% endif %}
  </div>

  <!-- FOOTER STRIP -->
  <div class="footer-strip">
    SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
  </div>
</section>

<style>
/* ========== DESKTOP STYLES ========== */
.homepage-banner {
  width: 100%;
  margin: 0;
  padding: 0;
  text-align: center;
}

.top-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 20px;
  background: #fff;
  border-bottom: 1px solid #eee;
}

.top-header-bar .nav-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hamburger {
  display: none; /* visible only on mobile */
  font-size: 22px;
  cursor: pointer;
}

.brand {
  font-weight: bold;
  font-size: 18px;
}

.nav-center {
  flex: 1;
  text-align: center;
  font-size: 14px;
  color: #333;
}

.nav-right .btn-yellow {
  background: #FFD700;
  color: black;
  border-radius: 4px;
  padding: 8px 16px;
  text-decoration: none;
  font-weight: 600;
}

.top-banner-container {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
}

.top-banner-img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}

.banner-text {
  position: absolute;
  bottom: 20px;
  left: 20px;
  text-align: left;
  max-width: 400px;
}

.banner-text h2 {
  font-size: 28px;
  margin-bottom: 10px;
}

.banner-text p {
  font-size: 16px;
  margin-bottom: 15px;
}

.btn-black {
  background: black;
  color: white;
  border-radius: 4px;
  padding: 10px 20px;
  text-decoration: none;
  font-weight: 600;
}

.bottom-banner-container {
  margin-top: 20px;
}

.bottom-banner-img {
  max-width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
  margin: 0 auto;
}

.footer-strip {
  background: #f8f8f8;
  color: red;
  padding: 10px;
  font-size: 14px;
  font-weight: bold;
  margin-top: 20px;
}

/* ========== MOBILE STYLES ========== */
@media screen and (max-width: 768px) {
  .top-header-bar {
    justify-content: center;
  }

  .top-header-bar .nav-left {
    flex: 1;
    justify-content: flex-start;
  }

  .hamburger {
    display: inline-block;
  }

  .brand {
    font-size: 16px;
  }

  .nav-center {
    display: none;
  }

  .nav-right {
    display: none;
  }

  .top-banner-container {
    display: none; /* hide top image on mobile */
  }

  .banner-text {
    position: static;
    text-align: center;
    margin: 20px auto;
    max-width: 90%;
  }

  .banner-text h2 {
    font-size: 24px;
  }

  .banner-text p {
    font-size: 14px;
  }

  .bottom-banner-container {
    position: relative;
  }

  .bottom-banner-img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* CTA overlays bottom image */
  .bottom-banner-container .btn-black {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
  }
}
</style>

{% schema %}
{
  "name": "Homepage Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top Banner Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Banner Image"
    }
  ],
  "presets": [
    {
      "name": "Homepage Banner"
    }
  ]
}
{% endschema %}
