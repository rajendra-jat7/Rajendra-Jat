{% schema %}
{
  "name": "Ecom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "header-left",
      "label": "Header Left Logo"
    },
    {
      "type": "text",
      "id": "header-center",
      "label": "Header Center Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "header-right-text",
      "label": "Header Right Button Text",
      "default": "CHOOSE GIFT →"
    },
    {
      "type": "image_picker",
      "id": "banner-top",
      "label": "Banner Top Image"
    },
    {
      "type": "image_picker",
      "id": "banner-bottom",
      "label": "Banner Bottom Image"
    },
    {
      "type": "text",
      "id": "banner-text",
      "label": "Banner Text",
      "default": "This is banner text"
    },
    {
      "type": "text",
      "id": "banner-button",
      "label": "Banner Button Text",
      "default": "Shop Now"
    }
  ]
}
{% endschema %}

<div class="homepage-banner">
  <!-- Top Header Bar -->
  <div class="top-header-bar">
    <button id="hbMenuBtn" class="hb-hamburger" aria-label="Open menu">&#9776;</button>
    <div class="header-left">
      {% if section.settings.header-left != blank %}
        <img src="{{ section.settings.header-left | image_url: width: 152 }}" 
             alt="Header Left" 
             class="header-left-img">
      {% endif %}
    </div>
    <div class="header-center">{{ section.settings.header-center }}</div>
    <div class="header-right">
      <a href="#" class="btn-yellow">{{ section.settings.header-right-text }}</a>
    </div>
  </div>

  <!-- Overlay Menu -->
  <div id="hbOverlay" class="hb-overlay" hidden>
    <button id="hbCloseBtn" class="hb-close" aria-label="Close menu">&times;</button>
    <div class="hb-overlay-content">
      {% if section.settings.header-left != blank %}
        <img src="{{ section.settings.header-left | image_url: width: 152 }}" 
             alt="Header Left" 
             class="header-left-img">
      {% endif %}
      <p class="hb-text">{{ section.settings.header-center }}</p>
      <a href="#" class="btn-yellow">{{ section.settings.header-right-text }}</a>
    </div>
  </div>

  <!-- Banner Content -->
  <div class="banner-content">
    {% if section.settings.banner-top != blank %}
      <img src="{{ section.settings.banner-top | image_url: width: 1600 }}" 
           alt="Banner Top" 
           class="banner-top-img">
    {% endif %}

    <div class="banner-bottom-wrapper">
      {% if section.settings.banner-bottom != blank %}
        <img src="{{ section.settings.banner-bottom | image_url: width: 1600 }}" 
             alt="Banner Bottom" 
             class="banner-bottom-img">
      {% endif %}

      <div class="banner-text-block">
        <h2>{{ section.settings.banner-text }}</h2>
        <a href="#" class="btn-yellow">{{ section.settings.banner-button }}</a>
      </div>
    </div>
  </div>
</div>

<style>
/* ---------- TOP HEADER ---------- */
.top-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  background: #fff;
  position: relative;
  border-bottom: 1px solid #eee;
}

.hb-hamburger {
  font-size: 24px;
  background: none;
  border: none;
  cursor: pointer;
}

.header-center {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 500;
}

.btn-yellow {
  background: #FFF544;
  color: black;
  padding: 10px 18px;
  border-radius: 4px;
  font-weight: 500;
  text-transform: uppercase;
  text-decoration: none;
  transition: transform 0.3s ease;
}
.btn-yellow:hover {
  transform: scale(1.05);
}

/* ---------- OVERLAY MENU ---------- */
.hb-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: white;
  z-index: 9999;
  display: none; /* <-- default hidden */
  flex-direction: column;
  align-items: center;
  justify-content: start;
  padding: 30px 20px;
}

.hb-overlay.active {
  display: flex; /* <-- visible only when active */
}

.hb-close {
  position: absolute;
  left: 15px;
  top: 20px;
  font-size: 28px;
  background: none;
  border: none;
  cursor: pointer;
}

.hb-overlay-content {
  margin-top: 40px;
  text-align: center;
}

.hb-text {
  margin: 20px 0;
  font-size: 16px;
}

/* ---------- BANNER ---------- */
.banner-content {
  margin-top: 20px;
  text-align: center;
}

.banner-top-img {
  width: 100%;
  height: auto;
  display: block;
}

.banner-bottom-wrapper {
  position: relative;
  margin-top: 20px;
}

.banner-bottom-img {
  width: 100%;
  height: auto;
  display: block;
}

.banner-text-block {
  position: absolute;
  top: 50%;
  left: 10%;
  transform: translateY(-50%);
  text-align: left;
}

.banner-text-block h2 {
  font-size: 28px;
  margin-bottom: 12px;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const menuBtn = document.getElementById("hbMenuBtn");
  const overlay = document.getElementById("hbOverlay");
  const closeBtn = document.getElementById("hbCloseBtn");

  menuBtn.addEventListener("click", () => {
    overlay.classList.add("active");
    menuBtn.style.display = "none";
  });

  closeBtn.addEventListener("click", () => {
    overlay.classList.remove("active");
    menuBtn.style.display = "block";
  });
});
</script>
