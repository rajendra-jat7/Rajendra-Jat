{% comment %}
------------------------------------------------------------
Ecom Banner Section
- Desktop:
  - Top image (full width)
  - Bottom section: left text + right image
- Mobile:
  - Only one mobile image
------------------------------------------------------------
{% endcomment %}

<div class="ecom-banner">
  <!-- Top Banner (Desktop only) -->
  {% if section.settings.top_image != blank %}
    <div class="banner-desktop-top hidden-mobile">
      <img 
        src="{{ section.settings.top_image | img_url: 'master' }}" 
        alt="Top Banner" 
        class="w-full h-auto"
      >
    </div>
  {% endif %}

  <!-- Bottom Banner with Text (Desktop only) -->
  <div class="banner-desktop-bottom hidden-mobile">
    <div class="banner-left-text">
      {% if section.settings.banner_text != blank %}
        <h2>{{ section.settings.banner_text }}</h2>
      {% endif %}
    </div>
    <div class="banner-right-img">
      {% if section.settings.bottom_image != blank %}
        <img 
          src="{{ section.settings.bottom_image | img_url: 'master' }}" 
          alt="Bottom Banner" 
          class="w-full h-auto"
        >
      {% endif %}
    </div>
  </div>

  <!-- Mobile Banner -->
  {% if section.settings.mobile_image != blank %}
    <div class="banner-mobile hidden-desktop">
      <img 
        src="{{ section.settings.mobile_image | img_url: 'master' }}" 
        alt="Mobile Banner" 
        class="w-full h-auto"
      >
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Ecom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "top_image",
      "label": "Top Banner Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Banner Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner Text",
      "default": "Find the ideal gift for your loved ones."
    }
  ],
  "presets": [
    {
      "name": "Ecom Banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
