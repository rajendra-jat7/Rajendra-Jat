<div class="ecom-banner">
  <!-- Desktop View -->
  <div class="ecom-banner-desktop">
    {% if section.settings.top_image != blank %}
      <img src="{{ section.settings.top_image | image_url }}" alt="Top Banner" class="ecom-banner-top">
    {% endif %}

    <div class="ecom-banner-bottom-wrapper">
      {% if section.settings.bottom_image != blank %}
        <img src="{{ section.settings.bottom_image | image_url }}" alt="Bottom Banner" class="ecom-banner-bottom">
      {% endif %}

      <div class="ecom-banner-text">
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
    </div>
  </div>

  <!-- Mobile View -->
  <div class="ecom-banner-mobile">
    {% if section.settings.mobile_image != blank %}
      <img src="{{ section.settings.mobile_image | image_url }}" alt="Mobile Banner" class="ecom-banner-mobile-img">
    {% endif %}
    <div class="ecom-banner-text-mobile">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ecom Banner",
  "settings": [
    { "type": "image_picker", "id": "top_image", "label": "Top Banner Image" },
    { "type": "image_picker", "id": "bottom_image", "label": "Bottom Banner Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile Banner Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." }
  ],
  "presets": [
    { "name": "Ecom Banner" }
  ]
}
{% endschema %}
