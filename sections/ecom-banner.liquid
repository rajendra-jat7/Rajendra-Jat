<div class="ecom-banner__bottom ecom-split">
  <div class="ecom-split__left">
    <div class="ecom-banner__content">
      {% if section.settings.kicker != blank %}
        <p class="ecom-banner__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ecom-banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="ecom-banner__sub rte">{{ section.settings.subheading }}</div>
      {% endif %}
      {% if section.settings.bottom_cta_label != blank %}
        <a class="ecom-banner__cta cta-anim" href="{{ section.settings.bottom_cta_url }}">
          {{ section.settings.bottom_cta_label }} <span class="cta-anim__arrow">→</span>
        </a>
      {% endif %}
      {% if section.settings.ribbon_text != blank %}
        <div class="ecom-banner__ribbon">{{ section.settings.ribbon_text }}</div>
      {% endif %}
    </div>
  </div>

  <div class="ecom-split__right">
    {% if section.settings.bottom_image %}
      <img class="ecom-banner__img" src="{{ section.settings.bottom_image | image_url: width: 3200 }}" alt="{{ section.settings.bottom_image.alt | escape }}">
    {% endif %}
  </div>
</div>


<style>
/* Split layout for bottom area */
#ecom-banner-{{ section.id }} .ecom-split{
  display:grid;
  grid-template-columns: 1fr 1fr; /* left text | right image */
  align-items: end;
  gap: clamp(12px,2.4vw,28px);
  position: relative;
}
#ecom-banner-{{ section.id }} .ecom-split__left{ padding-left: 3%; padding-bottom: 3%; }
#ecom-banner-{{ section.id }} .ecom-split__right{
  position: relative;
}
#ecom-banner-{{ section.id }} .ecom-split__right .ecom-banner__img{
  width: 100%;
  height: 100%;
  object-fit: cover;         /* keep image contained to right half */
  object-position: center;
  display:block;
}

/* Remove absolute overlay used earlier so text sits in left column */
#ecom-banner-{{ section.id }} .ecom-banner__content{ position: static; max-width: 560px; }

/* Mobile stacks */
@media (max-width: 990px){
  #ecom-banner-{{ section.id }} .ecom-split{
    grid-template-columns: 1fr;
  }
  #ecom-banner-{{ section.id }} .ecom-split__left{ order: 2; padding: 16px var(--pad) 28px; }
  #ecom-banner-{{ section.id }} .ecom-split__right{ order: 1; }
}

</style>