{% schema %}
{
  "name": "Homepage Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "header-left",
      "label": "Header Left Image"
    },
    {
      "type": "image_picker",
      "id": "top_banner_image",
      "label": "Top Banner Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_right_image",
      "label": "Bottom Right Image"
    }
  ]
}
{% endschema %}

<div class="homepage-banner">
  <!-- Top Header Bar -->
  <div class="top-header-bar">
  <button id="hbMenuBtn" class="hb-hamburger" aria-label="Open menu">&#9776;</button>
    <div class="header-left">
    {% if section.settings.header-left != blank %}
      <img src="{{ section.settings.header-left | image_url: width: 152 }}" 
           alt="Header Left" 
           class="header-left-img">
    {% endif %}
    </div>
    <div class="header-center">Find the ideal gift for your loved ones.</div>
    <div class="header-right">
      <a href="#" class="btn-yellow">CHOOSE GIFT →</a>
    </div>
  </div>

  <!-- Banner Content -->
<div class="banner-content">

  <!-- Top Banner Section -->
  <div class="top-banner-container">
    {% if section.settings.top_banner_image != blank %}
      <img src="{{ section.settings.top_banner_image | image_url: width: 1600 }}" 
           alt="Top Banner" 
           class="top-banner-img">
    {% endif %}
  </div>

  <!-- Bottom Banner Section -->
  <div class="bottom-banner-container">
    <div class="bottom-text">
      <h1>The Gift Guide</h1>
      <p>
        Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.
      </p>
      <a href="#" class="btn-black">SHOP NOW →</a>
    </div>

    {% if section.settings.bottom_right_image != blank %}
      <img src="{{ section.settings.bottom_right_image | image_url: width: 890 }}" 
           alt="Bottom Right Image" 
           class="bottom-right-img">
    {% endif %}
  </div>

  <!-- Footer Strip -->
  <div class="footer-strip">
    SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL
  </div>
</div>

<style>
/* ---------- HEADER BAR ---------- */
.top-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F5F5F5;
  padding: 10px 50px;
  height: 64px;
  font-size: 16px;
}
.header-left {
  font-weight: bold;
}
.header-center {
  text-align: center;
  flex: 1;
}
.header-right .btn-yellow {
  background: #FFF544;
  color: black;
  font-weight: 16px;
  padding: 8px 14px;
  border-radius: 4px;
  font-weight: 400;
  text-transform: uppercase;
  text-decoration: none;
}


#hbMenuBtn{
    display: none !important;
}

/* ---------- BANNER CONTENT ---------- */
.banner-content {
  width: 100%;
}

.top-banner-container {
  height : 390px;
  text-align: center;
  overflow : hidden;
  width: 100%;
  max-width: 1440px;
}

.top-banner-img {
  max-width: 100%;
  max-height: 100%
  object-fit: cover;
  display: block;
}

/* Bottom Banner */
.bottom-banner-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 403px;
}

.bottom-text {
  flex: 1;
  padding-left:30px;
}

.bottom-text h1 {
  font-size: 70px;
  font-weight: 500;
  font-weight: bold;
  margin-bottom: 10px;
}
.bottom-text p {
  margin-bottom: 20px;
  line-height: 1.4;
}
.btn-black {
  display: inline-block;
  padding: 10px 20px;
  background: black;
  color: white;
  text-decoration: none;
  border-radius: 4px;
}

.bottom-right-img {
  width: 890px;
  height: 100%;
  object-fit: contain;
}

/* ---------- FOOTER STRIP ---------- */
.footer-strip {
  height: 34px;
  font: Jost;
  font-weight: 400;
  line-height: 13.5px;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media screen and (max-width: 768px) {
  /* ---- HEADER ---- */
  .top-header-bar {
    position: relative;
    justify-content: center;
    padding: 10px 40px;
  }

  /* Hamburger left me */
  .hb-hamburger {
    display: block;
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 26px;
    background: none;
    border: none;
    cursor: pointer;
  }

  /* Hide center text + right button */
  .header-center, .header-right {
    display: none !important;
  }

  /* Logo center */
  .header-left {
    margin: 0 auto;
  }

  /* ---- BANNER ---- */
  .top-banner-container {
    display: none; /* top banner image hide */
  }

  .bottom-banner-container {
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    padding: 0 10px;
  }

  /* Text block upar */
  .bottom-text {
    order: 1;
    padding: 10px;
  }

  .bottom-text h1 {
    font-size: 28px;
    margin-bottom: 8px;
  }

  .bottom-text p {
    font-size: 15px;
    line-height: 1.4;
  }

  /* Image neeche (main banner) */
  .bottom-right-img {
    order: 2;
    width: 100% !important;
    height: auto !important;
    display: block;
    object-fit: contain;
  }

  /* SHOP NOW overlay on image */
  .btn-black {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-40%);
    z-index: 2;
    margin: 0;
    padding: 12px 22px;
    border-radius: 6px;
  }

  /* Footer strip smaller */
  .footer-strip {
    font-size: 12px;
    padding: 8px 4px;
    height: auto;
  }
}


</style>
