<section class="ecom-banner">
  <!-- Desktop -->
  <div class="ecom-banner__desktop">
    {% if section.settings.top_image %}
      <div class="ecom-banner__top">
        <img src="{{ section.settings.top_image | image_url: width: 1600 }}" alt="Top Banner" />
      </div>
    {% endif %}

    <div class="ecom-banner__bottom">
      {% if section.settings.bottom_image %}
        <div class="ecom-banner__bottom-image">
          <img src="{{ section.settings.bottom_image | image_url: width: 1600 }}" alt="Bottom Banner" />
        </div>
      {% endif %}

      <div class="ecom-banner__text">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Mobile -->
  <div class="ecom-banner__mobile">
    {% if section.settings.mobile_image %}
      <img src="{{ section.settings.mobile_image | image_url: width: 900 }}" alt="Mobile Banner" />
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Ecom Banner",
  "settings": [
    { "type": "image_picker", "id": "top_image", "label": "Top Image" },
    { "type": "image_picker", "id": "bottom_image", "label": "Bottom Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile Image" }
  ],
  "presets": [{ "name": "Ecom Banner" }]
}
{% endschema %}
